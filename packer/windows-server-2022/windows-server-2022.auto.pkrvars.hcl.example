# Exemple de fichier de variables pour Windows Server 2022 - Proxmox VE
# Copiez ce fichier vers windows-server-2022.auto.pkrvars.hcl et modifiez les valeurs

# ============================================================================
# Configuration Proxmox
# ============================================================================
proxmox_host            = "192.168.1.100"
proxmox_username        = "root@pam"
proxmox_password        = "VotreMotDePasse!"
# Ou utilisez un token API (recommandé):
# proxmox_token         = "packer@pve!packer-token=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
proxmox_skip_tls_verify = true
proxmox_node            = "pve"
proxmox_storage         = "local-lvm"
proxmox_iso_storage     = "local"
proxmox_network_bridge  = "vmbr0"
proxmox_network_vlan    = 0             # VLAN tag (0 = pas de VLAN)

# ============================================================================
# Configuration ISO
# ============================================================================
# ISO Windows Server 2022 (doit être uploadé sur Proxmox)
iso_file = "local:iso/SERVER_EVAL_x64FRE_fr-fr.iso"

# ISO VirtIO drivers (obligatoire pour Windows sur Proxmox)
# Téléchargez depuis: https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/stable-virtio/virtio-win.iso
virtio_iso_file = "local:iso/virtio-win.iso"

# ============================================================================
# Configuration VM
# ============================================================================
vm_id        = 9000          # ID de la VM (0 = auto)
vm_name      = "windows-server-2022-template"
vm_cpus      = 4
vm_memory    = 8192          # 8 GB
vm_disk_size = "60G"

# ============================================================================
# Configuration WinRM
# ============================================================================
winrm_username = "Administrator"
winrm_password = "P@ssw0rd123!"

# ============================================================================
# Configuration Windows
# ============================================================================
# Éditions disponibles: SERVERSTANDARDCORE, SERVERSTANDARD, SERVERDATACENTERCORE, SERVERDATACENTER
windows_edition = "SERVERSTANDARD"

# Clés KMS Windows Server 2022
# Standard: VDYBN-27WPP-V4HQT-9VMD4-VMK7H
# Datacenter: WX4NM-KYWYW-QJJR4-XV3QB-6VM33
windows_product_key = "VDYBN-27WPP-V4HQT-9VMD4-VMK7H"

# Fuseau horaire (voir: tzutil /l)
windows_timezone = "Romance Standard Time"

# Langue d'installation
windows_language = "fr-FR"
